{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JUW-MicroSlides",
  "version": "6.2.1",
  "identifier": "edu.juw.microslides",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:1420/pages.html",
    "beforeBuildCommand": "npm run desktop:icons && npm run build:desktop",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JUW-MicroSlides V6.2.1",
        "width": 1440,
        "height": 950,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "capabilities": [
        "main",
        "audience"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "juwslides"
        ],
        "name": "JUW lecture project",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
