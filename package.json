{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17",
    "image-size": "2.0.3",
    "source-map-js": "1.2.2"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/with-app-env.mjs vite build && npm run db:migrate",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "test": "node --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --test src/lib/app-data/app-data.test.ts src/lib/app-data/readiness-schedule.test.ts src/lib/auth/gate-identity.test.ts src/lib/auth/sign-in-gate.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:pages": "vite build --config vite.pages.config.ts && node scripts/build-pages.mjs",
    "preview:pages": "vite preview --config vite.pages.config.ts --host 0.0.0.0 --port 8081",
    "test:research": "node scripts/test-research.mjs",
    "qa:pages": "node scripts/qa-pages.mjs",
    "test:topics": "node scripts/test-topic-quality.mjs",
    "test:generation": "node scripts/test-generation-count.mjs",
    "dev:desktop": "npm run desktop:icons && vite --config vite.desktop.config.ts",
    "build:desktop": "vite build --config vite.desktop.config.ts && node scripts/build-desktop.mjs",
    "desktop": "tauri",
    "desktop:build": "tauri build -- --locked",
    "test:professional": "node scripts/test-professional.mjs",
    "desktop:icons": "tauri icon public/juw-crest-transparent.svg --output src-tauri/icons",
    "test:scientific": "node scripts/test-scientific.mjs",
    "benchmark:live": "node scripts/benchmark-live.mjs",
    "benchmark:semantic": "node scripts/benchmark-semantic.mjs",
    "review:scientific": "node scripts/scientific-review.mjs",
    "benchmark:semantic:local": "node scripts/benchmark-semantic-local.mjs",
    "test:lecturer": "node scripts/test-lecturer-workflow.mjs",
    "test:teaching": "node scripts/test-teaching.mjs",
    "test:release": "node scripts/test-release-gates.mjs",
    "qualify:semantic": "node scripts/qualify-semantic.mjs",
    "test:audit": "node scripts/test-audit-regressions.mjs",
    "qa:reviewed-export": "node scripts/test-reviewed-export.mjs",
    "test:lecture": "node scripts/test-lecture-modes.mjs",
    "qa:lecture": "node scripts/qa-lecture-modes.mjs",
    "test:version-lock": "node --test scripts/version-lock.test.mjs",
    "qa:topic-recovery": "node scripts/qa-topic-recovery.mjs"
  },
  "dependencies": {
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@citation-js/plugin-csl": "^0.9.0",
    "@electric-sql/pglite": "^0.5.4",
    "@hookform/resolvers": "^5.7.0",
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "~1.168.60",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.168.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "better-auth": "~1.6.30",
    "citeproc": "^2.4.63",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "fast-xml-parser": "^5.11.2",
    "jose": "6.2.9",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "kysely": "^0.28.5",
    "lucide-react": "^0.510.0",
    "papaparse": "^5.7.0",
    "pg": "^8.16.3",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.13.0",
    "sonner": "^2.0.7",
    "svg2pdf.js": "^2.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^22.16.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "8.2.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.9.0",
  "version": "6.2.1"
}
